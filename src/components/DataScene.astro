---
const contours = Array.from({ length: 16 }, (_, i) => {
  const points = Array.from({ length: 121 }, (_, j) => {
    const a = j / 120 * Math.PI * 2;
    const r = 37 + i * 10 + Math.sin(a * 3 + i * .15) * (12 + i * .5) + Math.cos(a * 5) * 7;
    return `${250 + Math.cos(a) * r * 1.1},${210 + Math.sin(a) * r * .74}`;
  }).join(' ');
  return points;
});
---
<div class="data-scene" role="img" aria-label="Ilustración conceptual de un pipeline: datos satelitales, modelo y alerta">
  <div class="scene-orbit orbit-one"></div><div class="scene-orbit orbit-two"></div>
  <div class="scene-label"><span class="status-dot"></span> DEL DATO A LA DECISIÓN <span>/ 01</span></div>
  <div class="scene-stack" data-parallax>
    <div class="map-layer layer-bottom"><span>03 / DECISIÓN</span></div>
    <div class="map-layer layer-middle"><span>02 / MODELO</span></div>
    <div class="map-layer layer-top">
      <svg viewBox="0 0 500 420" fill="none" aria-hidden="true">
        <defs>
          <radialGradient id="map-glow"><stop stop-color="#ffb078" stop-opacity=".18"/><stop offset="1" stop-color="#ffb078" stop-opacity="0"/></radialGradient>
          <pattern id="map-grid" width="42" height="42" patternUnits="userSpaceOnUse"><path d="M42 0H0v42" stroke="#ffb078" stroke-opacity=".12" stroke-width="1"/></pattern>
        </defs>
        <path fill="url(#map-grid)" d="M0 0h500v420H0z"/><ellipse cx="250" cy="210" rx="245" ry="180" fill="url(#map-glow)"/>
        {contours.map((points, i) => <polygon points={points} stroke="#ffb078" stroke-opacity={.25 + i / 40} stroke-width={i % 4 === 0 ? 1.5 : .7} />)}
        <path d="M250 170v80m-40-40h80" stroke="#ffe5c9" stroke-opacity=".7"/>
        <circle cx="250" cy="210" r="8" fill="#ffb078" fill-opacity=".25" stroke="#ffb078"/><circle cx="250" cy="210" r="2.5" fill="#fff0db"/>
      </svg>
      <span>01 / OBSERVACIÓN</span><span class="map-coordinate">SENTINEL-2/3</span>
    </div>
  </div>
  <div class="scene-tag tag-data"><span class="tag-icon">↗</span><div><small>INPUT</small><strong>Datos satelitales</strong><span>+ variables ambientales</span></div></div>
  <div class="scene-tag tag-model"><span class="status-dot"></span><div><small>VALIDACIÓN</small><strong>Walk-forward</strong></div><span class="mini-bars"><i></i><i></i><i></i><i></i><i></i></span></div>
  <div class="scene-caption"><span>OBSERVAR → MODELAR → ACTUAR</span><span>ESQUEMA CONCEPTUAL</span></div>
</div>
